
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isAnonymous() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isOwnerOf(ownerId) {
      return isAdmin() && request.auth.uid == ownerId;
    }

    // Tenant ownership is immutable after creation. Checking both maps with a
    // default also keeps legacy documents without ownerId from throwing during
    // rule evaluation; no update may add, remove or replace the field.
    function ownerIdIsUnchanged() {
      return request.resource.data.get('ownerId', null)
        == resource.data.get('ownerId', null);
    }

    // ── Operadores (frente de caixa) ──
    // roles_operador/{uid} mapeia um login de operador para a loja (ownerId).
    // Operador ATIVO tem acesso de "staff" apenas ao operacional (pedidos,
    // caixa e estoque); clientes, cadastros e perfil continuam só do dono.
    function isOperator() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_operador/$(request.auth.uid));
    }

    function operatorData() {
      return get(/databases/$(database)/documents/roles_operador/$(request.auth.uid)).data;
    }

    function isActiveOperator() {
      return isOperator() && operatorData().active == true;
    }

    function isOperatorOf(ownerId) {
      return isActiveOperator() && operatorData().ownerId == ownerId;
    }

    // Permissões de operador são sempre fail-closed nas rules. Diferente do
    // perfil legado do dono, campo ausente/inválido NUNCA concede acesso.
    function operatorPdvPermissions() {
      return operatorData().get('permissions', {}).get('pdv', {});
    }

    // As checagens abaixo recebem o bloco de permissões JÁ RESOLVIDO em vez de
    // chamar operatorPdvPermissions() de novo a cada linha. Cada chamada dessa
    // relê o documento do operador, e as regras de pedido encadeiam dezenas
    // delas — era o que estourava o limite de 1000 expressões das rules.
    // O `&&` garante que a leitura só acontece depois de isOperatorOf passar.
    function pdvAllowsTab(pdv, tab) {
      return pdv.get('enabled', false) == true
        && pdv.get('tabs', {}).get(tab, false) == true;
    }

    function pdvAllowsAction(pdv, group, action) {
      return pdvAllowsTab(pdv, group)
        && pdv.get('actions', {}).get(group, {}).get(action, false) == true;
    }

    // O documento do operador é lido UMA vez e desce por parâmetro. Antes cada
    // checagem o relia três vezes (duas em isOperatorOf, uma nas permissões);
    // multiplicado pelas dezenas de checagens das regras de pedido, era isso
    // que estourava o orçamento de avaliação.
    function operatorDocMatches(d, ownerId) {
      return d.active == true && d.ownerId == ownerId;
    }

    function pdvOf(d) {
      return d.get('permissions', {}).get('pdv', {});
    }

    function operatorTabOk(d, ownerId, tab) {
      return operatorDocMatches(d, ownerId) && pdvAllowsTab(pdvOf(d), tab);
    }

    function operatorActionOk(d, ownerId, group, action) {
      return operatorDocMatches(d, ownerId) && pdvAllowsAction(pdvOf(d), group, action);
    }

    function operatorCanPdvTab(ownerId, tab) {
      return isOperator() && operatorTabOk(operatorData(), ownerId, tab);
    }

    function operatorCanPdvAction(ownerId, group, action) {
      return isOperator() && operatorActionOk(operatorData(), ownerId, group, action);
    }

    function operatorCanPdvGlobal(ownerId, control) {
      return isOperatorOf(ownerId)
        && operatorPdvPermissions().get('enabled', false) == true
        && operatorPdvPermissions().get('global', {}).get(control, false) == true;
    }

    // ── Retaguarda: o que o dono liberou tela a tela ──
    //
    // Duas decisões por módulo: `ver` abre a tela, `editar` deixa gravar. Os
    // primeiros perfis guardavam um booleano por módulo; ele continua valendo
    // como "só ver". Como em todo o resto do arquivo, o documento do operador é
    // lido UMA vez e desce por parâmetro, para não estourar o orçamento de
    // expressões das regras.
    function retaguardaDe(d) {
      return d.get('permissions', {}).get('retaguarda', {});
    }

    function moduloVer(ret, modulo) {
      let m = ret.get(modulo, false);
      return m == true || (m is map && m.get('ver', false) == true);
    }

    function moduloEditar(ret, modulo) {
      let m = ret.get(modulo, false);
      return m is map && m.get('ver', false) == true && m.get('editar', false) == true;
    }

    function operatorVeModulo(ownerId, modulo) {
      return isOperator() && operatorVeOk(operatorData(), ownerId, modulo);
    }

    function operatorVeOk(d, ownerId, modulo) {
      return operatorDocMatches(d, ownerId) && moduloVer(retaguardaDe(d), modulo);
    }

    function operatorEditaModulo(ownerId, modulo) {
      return isOperator() && operatorEditaOk(operatorData(), ownerId, modulo);
    }

    function operatorEditaOk(d, ownerId, modulo) {
      return operatorDocMatches(d, ownerId) && moduloEditar(retaguardaDe(d), modulo);
    }

    /** Pedidos alimentam Dashboard, Relatórios, ficha do cliente e entregas. */
    function operatorVeHistorico(ownerId) {
      return isOperator() && operatorHistoricoOk(operatorData(), ownerId);
    }

    function operatorHistoricoOk(d, ownerId) {
      let ret = retaguardaDe(d);
      return operatorDocMatches(d, ownerId) && (
        moduloVer(ret, 'dashboard')
        || moduloVer(ret, 'relatorios')
        || moduloVer(ret, 'clientes')
        || moduloVer(ret, 'prazo')
        || moduloVer(ret, 'entregas')
        || moduloVer(ret, 'encomendas')
      );
    }

    function valueUsesContaCasa(value) {
      return value is string && value.matches('.*conta_casa.*');
    }

    function usesContaCasa(data) {
      return valueUsesContaCasa(data.get('paymentMethod', ''));
    }

    function operatorCanReadOrders(ownerId) {
      return operatorCanPdvTab(ownerId, 'delivery')
        || operatorCanPdvTab(ownerId, 'novo_pedido')
        || operatorCanPdvTab(ownerId, 'mesas');
    }

    function operatorCanCreateOrder(ownerId, data) {
      return !usesContaCasa(data) && (
        (data.get('orderType', '') == 'dine_in'
          && operatorCanPdvAction(ownerId, 'mesas', 'gerenciarMesa')
          && operatorCanPdvAction(ownerId, 'mesas', 'lancarItens'))
        || (data.get('source', '') == 'pdv'
          && data.get('orderType', '') != 'dine_in'
          && operatorCanPdvAction(ownerId, 'novo_pedido', 'finalizarVenda')
          && ((data.get('discount', 0) == 0 && data.get('surcharge', 0) == 0)
            || operatorCanPdvAction(ownerId, 'novo_pedido', 'descontoAcrescimo'))
          && !usesContaCasa(data))
      );
    }

    // Oito capacidades diferentes mexem em estoque. Resolvendo as permissões uma
    // única vez, em vez de oito, o custo desta função cai na mesma proporção.
    function pdvAllowsInventory(pdv) {
      return pdvAllowsAction(pdv, 'delivery', 'finalizarPedido')
        || pdvAllowsAction(pdv, 'delivery', 'editarItens')
        || pdvAllowsAction(pdv, 'delivery', 'cancelarPedido')
        || pdvAllowsAction(pdv, 'novo_pedido', 'finalizarVenda')
        || pdvAllowsAction(pdv, 'mesas', 'lancarItens')
        || pdvAllowsAction(pdv, 'mesas', 'fecharComanda')
        || pdvAllowsAction(pdv, 'mesas', 'gerenciarMesa')
        || pdvAllowsAction(pdv, 'mesas', 'aceitarPedidoOnline');
    }

    function operatorCanAdjustInventory(ownerId) {
      return isOperator() && operatorDocMatches(operatorData(), ownerId)
        && pdvAllowsInventory(pdvOf(operatorData()));
    }

    function operatorCanOperateCash(ownerId) {
      // useCaixa é compartilhado pelas vendas: mesmo sem exibir a aba Caixa,
      // essas ações precisam descobrir o caixa aberto e lançar o pagamento.
      return operatorCanPdvTab(ownerId, 'caixa')
        || operatorCanPdvAction(ownerId, 'delivery', 'finalizarPedido')
        || operatorCanPdvAction(ownerId, 'novo_pedido', 'finalizarVenda')
        || operatorCanPdvAction(ownerId, 'mesas', 'fecharComanda')
        || operatorCanPdvAction(ownerId, 'encomendas_pedidos', 'lancarSinal');
    }

    function operatorCanUpdateDeliveryOrder(pdv) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let nextStatus = request.resource.data.get('status', resource.data.get('status', ''));
      return resource.data.get('orderType', '') in ['delivery', 'pickup'] && (
        (nextStatus == 'canceled'
          && changed.hasOnly(['status', 'stockDeducted', 'stockDeductedItems'])
          && pdvAllowsAction(pdv, 'delivery', 'cancelarPedido'))
        || (nextStatus == 'delivered'
          && changed.hasOnly(['status', 'paymentMethod', 'payments', 'discount', 'surcharge',
            'payDeliveryToMotoboy', 'totalAmount',
            'customerIdentityPending',
            'stockDeducted', 'stockDeductedItems'])
          && pdvAllowsAction(pdv, 'delivery', 'finalizarPedido')
          && ((request.resource.data.get('discount', 0)
                == resource.data.get('discount', 0)
              && request.resource.data.get('surcharge', 0)
                == resource.data.get('surcharge', 0))
            || pdvAllowsAction(pdv, 'delivery', 'descontoAcrescimo')))
        || (changed.hasOnly(['items', 'subtotal', 'totalAmount',
              'stockDeducted', 'stockDeductedItems'])
          && changed.hasAny(['items', 'subtotal', 'totalAmount'])
          && pdvAllowsAction(pdv, 'delivery', 'editarItens'))
        || (nextStatus != 'delivered' && nextStatus != 'canceled'
          && changed.hasOnly(['status', 'motoboyId', 'orderType'])
          && pdvAllowsAction(pdv, 'delivery', 'mudarStatus'))
        || (changed.hasOnly(['stockDeducted', 'stockDeductedItems'])
          && pdvAllowsInventory(pdv))
        || (changed.hasOnly(['customerCounted'])
          && request.resource.data.customerCounted == true
          && (pdvAllowsAction(pdv, 'delivery', 'finalizarPedido')
            || (resource.data.get('source', '') == 'pdv'
              && pdvAllowsAction(pdv, 'novo_pedido', 'finalizarVenda'))))
        || (changed.hasOnly(['receivedMessageSent', 'pixProofMessageSent',
              'outForDeliveryMessageSent', 'canceledMessageSent'])
          && pdvAllowsTab(pdv, 'delivery'))
      );
    }

    function operatorCanUpdateTableOrder(pdv) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let nextStatus = request.resource.data.get('status', resource.data.get('status', ''));
      return resource.data.get('orderType', '') == 'dine_in' && (
        (nextStatus == 'canceled'
          && changed.hasOnly(['status', 'items', 'subtotal', 'totalAmount',
            'stockDeducted', 'stockDeductedItems'])
          && (pdvAllowsAction(pdv, 'mesas', 'gerenciarMesa')
            || (resource.data.get('source', '') != 'pdv'
              && resource.data.get('accepted', false) != true
              && pdvAllowsAction(pdv, 'mesas', 'aceitarPedidoOnline'))))
        || (nextStatus == 'delivered'
          && changed.hasOnly(['status', 'paymentMethod', 'payments', 'discount', 'surcharge',
            'subtotal', 'totalAmount', 'customerName', 'customerPhone', 'clienteId',
            'customerIdentityPending',
            'stockDeducted', 'stockDeductedItems'])
          && pdvAllowsAction(pdv, 'mesas', 'fecharComanda')
          && ((request.resource.data.get('discount', 0)
                == resource.data.get('discount', 0)
              && request.resource.data.get('surcharge', 0)
                == resource.data.get('surcharge', 0))
            || pdvAllowsAction(pdv, 'mesas', 'descontoAcrescimo'))
          && (!usesContaCasa(request.resource.data)
            || pdvAllowsAction(pdv, 'mesas', 'vendaPrazo'))
          && (!changed.hasAny(['clienteId'])
            || !request.resource.data.keys().hasAny(['clienteId'])))
        || (changed.hasOnly(['items', 'subtotal', 'totalAmount',
              'customerName', 'customerPhone', 'clienteId', 'customerIdentityPending',
              'stockDeducted', 'stockDeductedItems'])
          && changed.hasAny(['items', 'subtotal', 'totalAmount'])
          && pdvAllowsAction(pdv, 'mesas', 'lancarItens')
          && (!changed.hasAny(['customerName', 'customerPhone', 'clienteId'])
            || pdvAllowsAction(pdv, 'mesas', 'gerenciarMesa'))
          && (!changed.hasAny(['clienteId'])
            || !request.resource.data.keys().hasAny(['clienteId'])))
        || (changed.hasOnly(['customerName', 'customerPhone', 'clienteId', 'customerIdentityPending'])
          && pdvAllowsAction(pdv, 'mesas', 'gerenciarMesa')
          && (!changed.hasAny(['clienteId'])
            || !request.resource.data.keys().hasAny(['clienteId'])))
        || (changed.hasOnly(['tableNumber', 'accepted'])
          && changed.hasAny(['tableNumber'])
          && pdvAllowsAction(pdv, 'mesas', 'gerenciarMesa')
          && ((resource.data.get('source', '') == 'pdv'
                || resource.data.get('accepted', false) == true)
            || pdvAllowsAction(pdv, 'mesas', 'aceitarPedidoOnline')))
        || (changed.hasOnly(['accepted'])
          && request.resource.data.accepted == true
          && pdvAllowsAction(pdv, 'mesas', 'aceitarPedidoOnline'))
        || (changed.hasOnly(['status'])
          && nextStatus == 'awaiting_payment'
          && pdvAllowsAction(pdv, 'mesas', 'fecharComanda'))
        || (changed.hasOnly(['status'])
          && nextStatus == 'pending'
          && pdvAllowsAction(pdv, 'mesas', 'gerenciarMesa'))
        || (changed.hasOnly(['stockDeducted', 'stockDeductedItems'])
          && pdvAllowsInventory(pdv))
        || (changed.hasOnly(['customerCounted'])
          && request.resource.data.customerCounted == true
          && pdvAllowsAction(pdv, 'mesas', 'fecharComanda'))
        || (changed.hasOnly(['receivedMessageSent', 'pixProofMessageSent',
              'outForDeliveryMessageSent', 'canceledMessageSent'])
          && pdvAllowsTab(pdv, 'mesas'))
      );
    }

    // Ponto de entrada: identifica o operador e resolve as permissões UMA vez;
    // as ~25 checagens abaixo trabalham em cima do resultado, sem reconsultar.
    function operatorCanUpdateOrder(ownerId) {
      return isOperator() && operatorUpdateOrderOk(operatorData(), ownerId);
    }

    function operatorUpdateOrderOk(d, ownerId) {
      return operatorDocMatches(d, ownerId)
        && !usesContaCasa(resource.data)
        && !usesContaCasa(request.resource.data)
        && (operatorCanUpdateDeliveryOrder(pdvOf(d))
          || operatorCanUpdateTableOrder(pdvOf(d)));
    }

    /** Uma família por vez (delivery/retirada ou mesa), para dividir o custo. */
    function operatorCanUpdateOrderFamily(ownerId, ehDelivery) {
      return isOperator() && operatorUpdateFamilyOk(operatorData(), ownerId, ehDelivery);
    }

    function operatorUpdateFamilyOk(d, ownerId, ehDelivery) {
      return operatorDocMatches(d, ownerId)
        && !usesContaCasa(resource.data)
        && !usesContaCasa(request.resource.data)
        && (ehDelivery
          ? operatorCanUpdateDeliveryOrder(pdvOf(d))
          : operatorCanUpdateTableOrder(pdvOf(d)));
    }

    function cashRegisterOwner(registerId) {
      return get(/databases/$(database)/documents/cash_registers/$(registerId)).data.ownerId;
    }

    function cashRegisterIsOpen(registerId, ownerId) {
      let register = get(
        /databases/$(database)/documents/cash_registers/$(registerId)).data;
      return register.ownerId == ownerId && register.status == 'aberto';
    }

    function cashRegisterWillBeClosed(registerId, ownerId) {
      let registerAfter = getAfter(
        /databases/$(database)/documents/cash_registers/$(registerId)).data;
      return registerAfter.ownerId == ownerId
        && registerAfter.status == 'fechado';
    }

    function operatorCanCreateCashTransaction(ownerId, data) {
      let type = data.get('tipo', '');
      return cashRegisterOwner(data.caixaId) == ownerId && (
        // No batch de fechamento, suprimentos/sangrias automáticos pertencem
        // à capacidade fecharCaixa (não aos botões manuais homônimos).
        (type in ['sangria', 'suprimento', 'fechamento', 'retirada_fechamento']
          && cashRegisterIsOpen(data.caixaId, ownerId)
          && cashRegisterWillBeClosed(data.caixaId, ownerId)
          && operatorCanPdvAction(ownerId, 'caixa', 'fecharCaixa'))
        || (cashRegisterIsOpen(data.caixaId, ownerId) && (
          (type == 'abertura'
            && operatorCanPdvAction(ownerId, 'caixa', 'abrirCaixa'))
          || (type == 'sangria'
            && operatorCanPdvAction(ownerId, 'caixa', 'sangria'))
          || (type == 'suprimento'
            && operatorCanPdvAction(ownerId, 'caixa', 'suprimento'))
          || (type == 'venda' && (
            !valueUsesContaCasa(data.get('formaPagamento', ''))
            && (operatorCanPdvAction(ownerId, 'delivery', 'finalizarPedido')
              || operatorCanPdvAction(ownerId, 'novo_pedido', 'finalizarVenda')
              || operatorCanPdvAction(ownerId, 'mesas', 'fecharComanda')
              || operatorCanPdvAction(ownerId, 'encomendas_pedidos', 'lancarSinal'))
          ))
        ))
      );
    }

    // Regras para a coleção roles_admin
    match /roles_admin/{userId} {
      // Cadastro de loja cria o próprio registro de admin. Login anônimo
      // (clientes do cardápio) não pode se autopromover a admin.
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        // Um operador já provisionado jamais pode virar master criando o
        // próprio roles_admin. Novas lojas legítimas ainda usam este fluxo.
        && !exists(/databases/$(database)/documents/roles_operador/$(request.auth.uid));
      allow get, list, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false; // Por segurança, não permite deletar admin via app
    }

    match /roles_operador/{operatorUid} {
      // O próprio operador lê seu papel (é assim que o app resolve qual loja
      // ele opera); o dono lê/lista/edita os operadores da SUA loja.
      allow get: if isSignedIn() && (
        request.auth.uid == operatorUid ||
        (isAdmin() && resource.data.ownerId == request.auth.uid)
      );
      allow list: if isAdmin() && resource.data.ownerId == request.auth.uid;
      // Todo write passa pela API/Admin SDK: além de criar/remover o usuário do
      // Auth, ela valida ownerId e impede promoção/edição das próprias flags.
      allow create, update, delete: if false;
    }

    // Segredo da senha da Retaguarda. Nunca fica no perfil público da loja:
    // somente a sessão autenticada do próprio dono pode ler ou alterar.
    match /admin_secrets/{userId} {
      allow read, write: if isAdmin() && request.auth.uid == userId;
    }

    // Regras para Categorias e Itens
    // Adicionamos a lógica de ownerId para isolar os dados
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create: if (isAdmin() && request.resource.data.ownerId == request.auth.uid)
        || operatorEditaModulo(request.resource.data.ownerId, 'categorias');
      allow update: if ownerIdIsUnchanged() && (
        (isAdmin() && resource.data.ownerId == request.auth.uid)
        || operatorEditaModulo(resource.data.ownerId, 'categorias'));
      allow delete: if (isAdmin() && resource.data.ownerId == request.auth.uid)
        || operatorEditaModulo(resource.data.ownerId, 'categorias');
    }

    match /menuItems/{menuItemId} {
      allow get, list: if true;
      allow create, delete: if (isAdmin() && (
        (request.method == 'create' && request.resource.data.ownerId == request.auth.uid) ||
        (resource.data.ownerId == request.auth.uid)
      )) || (request.method == 'create'
        ? operatorEditaModulo(request.resource.data.ownerId, 'produtos')
        : operatorEditaModulo(resource.data.ownerId, 'produtos'));
      // Cliente (anônimo) só pode BAIXAR o estoque ao fazer pedido — nunca
      // aumentar nem deixar negativo. Reposição/estorno é só do dono (admin).
      // Operador ativo pode mexer APENAS no estoque (baixa na venda e estorno
      // no cancelamento via lib/inventory) — nunca em preço/nome/etc.
      allow update: if ownerIdIsUnchanged() && (
        isOwnerOf(resource.data.ownerId) ||
          operatorEditaModulo(resource.data.ownerId, 'produtos') ||
          // Contagem de estoque é a aba Estoque; preço e nome, a aba Produtos.
          (operatorEditaModulo(resource.data.ownerId, 'estoque')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockQuantity'])) ||
          (operatorCanAdjustInventory(resource.data.ownerId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockQuantity'])) ||
          (isAnonymous()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockQuantity'])
            && request.resource.data.stockQuantity is number
            && request.resource.data.stockQuantity >= 0
            && resource.data.stockQuantity is number
            && request.resource.data.stockQuantity < resource.data.stockQuantity)
      );
    }

    // Histórico de movimentação de estoque (entrada/saída/ajuste manual).
    // É um livro de registro: nasce e nunca muda — sem update, sem delete, nem
    // para o dono. Venda NÃO é gravada aqui (a tela deriva dos pedidos), então
    // o cliente anônimo do cardápio não precisa de escrita nesta coleção.
    match /stock_movements/{movementId} {
      allow get, list: if isOwnerOf(resource.data.ownerId)
        || (isActiveOperator() && operatorData().ownerId == resource.data.ownerId);
      // A regra acima já cobre o operador da loja; a aba Estoque não precisa de
      // uma leitura própria porque o histórico é o mesmo documento.
      // Formato primeiro, permissão depois: operatorCanAdjustInventory percorre
      // 6 checagens com leitura de documento e é o que mais gasta orçamento de
      // avaliação das rules. Conferir os campos antes faz o payload malformado
      // cair barato, sem chegar perto do limite de expressões.
      allow create: if request.resource.data.delta is number
        // stockAfter null = o produto passou a não ter controle de estoque.
        && (request.resource.data.stockAfter == null
          || (request.resource.data.stockAfter is number
            && request.resource.data.stockAfter >= 0))
        && request.resource.data.itemId is string
        && (isOwnerOf(request.resource.data.ownerId)
          || operatorEditaModulo(request.resource.data.ownerId, 'estoque')
          || operatorCanAdjustInventory(request.resource.data.ownerId));
      allow update, delete: if false;
    }

    match /addons/{addonId} {
      allow get, list: if true;
      allow create: if (isAdmin() && request.resource.data.ownerId == request.auth.uid)
        || operatorEditaModulo(request.resource.data.ownerId, 'adicionais');
      allow update: if ownerIdIsUnchanged() && (
        (isAdmin() && resource.data.ownerId == request.auth.uid)
        || operatorEditaModulo(resource.data.ownerId, 'adicionais'));
      allow delete: if (isAdmin() && resource.data.ownerId == request.auth.uid)
        || operatorEditaModulo(resource.data.ownerId, 'adicionais');
    }

    match /addonCategories/{categoryId} {
      allow get, list: if true;
      allow create: if (isAdmin() && request.resource.data.ownerId == request.auth.uid)
        || operatorEditaModulo(request.resource.data.ownerId, 'adicionais');
      allow update: if ownerIdIsUnchanged() && (
        (isAdmin() && resource.data.ownerId == request.auth.uid)
        || operatorEditaModulo(resource.data.ownerId, 'adicionais'));
      allow delete: if (isAdmin() && resource.data.ownerId == request.auth.uid)
        || operatorEditaModulo(resource.data.ownerId, 'adicionais');
    }

    match /customers/{userId} {
      allow get, update, create: if isSignedIn() && request.auth.uid == userId;
      allow list, delete: if false;
    }

    match /orders/{orderId} {
      // Cliente lê os próprios pedidos via customerUid (uid anônimo gravado
      // na criação); a equipe da loja (dono ou operador) lê os pedidos dela.
      // A query do cliente PRECISA filtrar por customerUid == uid.
      allow get, list: if isSignedIn() && (
        resource.data.customerUid == request.auth.uid ||
        isOwnerOf(resource.data.ownerId) ||
        operatorCanReadOrders(resource.data.ownerId) ||
        operatorVeHistorico(resource.data.ownerId)
      );
      // Separado em três declarações em vez de um `||` só. Cada `allow` é
      // avaliado por si, então as ~25 checagens de delivery e as de mesa não se
      // somam no mesmo orçamento de expressões — que é o que vinha estourando o
      // limite de 1000 e abortando a avaliação no meio.
      allow update: if ownerIdIsUnchanged()
        && isOwnerOf(resource.data.ownerId);
      allow update: if ownerIdIsUnchanged()
        && operatorCanUpdateOrderFamily(resource.data.ownerId, true);
      allow update: if ownerIdIsUnchanged()
        && operatorCanUpdateOrderFamily(resource.data.ownerId, false);
      allow create: if isSignedIn() && (
        request.resource.data.customerUid == request.auth.uid ||
        isOwnerOf(request.resource.data.ownerId) ||
        operatorCanCreateOrder(request.resource.data.ownerId, request.resource.data)
      );
      allow delete: if false;
    }

    // Encomendas (modalidade confeitaria): mesmo modelo de orders, em coleção
    // PRÓPRIA (não filtrada pela janela do caixa — registra com caixa fechado).
    // Cliente (anônimo) cria a própria encomenda (customerUid == uid); a
    // equipe da loja lê/atualiza as encomendas dela.
    match /encomendas/{encomendaId} {
      allow get, list: if isSignedIn() && (
        resource.data.customerUid == request.auth.uid ||
        isOwnerOf(resource.data.ownerId) ||
        operatorCanPdvTab(resource.data.ownerId, 'encomendas_pedidos') ||
        operatorVeModulo(resource.data.ownerId, 'encomendas')
      );
      allow create: if isSignedIn() && (
        request.resource.data.customerUid == request.auth.uid ||
        isOwnerOf(request.resource.data.ownerId) ||
        operatorEditaModulo(request.resource.data.ownerId, 'encomendas')
      );
      allow update: if ownerIdIsUnchanged() && (
        isOwnerOf(resource.data.ownerId)
        || operatorEditaModulo(resource.data.ownerId, 'encomendas') || (
          isOperatorOf(resource.data.ownerId)
          && !usesContaCasa(resource.data)
          && !usesContaCasa(request.resource.data) && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && operatorCanPdvAction(resource.data.ownerId,
              'encomendas_pedidos', 'mudarStatus'))
          // Lançar a entrada no caixa: marca o sinal e soma em valorPago (o
          // campo que diz quanto ainda falta receber na entrega).
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sinalLancado', 'valorPago'])
            && request.resource.data.sinalLancado == true
            && operatorCanPdvAction(resource.data.ownerId,
              'encomendas_pedidos', 'lancarSinal'))
          // Fechamento da entrega: recebe o que falta e marca como entregue.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'valorPago'])
            && request.resource.data.status == 'entregue'
            && operatorCanPdvAction(resource.data.ownerId,
              'encomendas_pedidos', 'mudarStatus')
            && operatorCanPdvAction(resource.data.ownerId,
              'encomendas_pedidos', 'lancarSinal'))
          // Editar o pedido: contato, entrega, ITENS e os valores que eles
          // recalculam. `valorPago`/`sinalLancado` ficam de fora de propósito —
          // dizer quanto já entrou é do fluxo de caixa, não da edição.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'delivery', 'orderNotes', 'customerName', 'customerPhone', 'customerBirthDate',
                'isEmpresa', 'products', 'bolo', 'especialItems', 'tortasItems', 'docinhosItems',
                'subtotal', 'deliveryFee', 'total', 'sinalPercent', 'sinal', 'saldo',
                'comprovanteUrl', 'source', 'status'])
            && operatorCanPdvAction(resource.data.ownerId,
              'encomendas_pedidos', 'editarEncomenda')
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
              || operatorCanPdvAction(resource.data.ownerId,
                'encomendas_pedidos', 'mudarStatus')))
          )
        )
      );
      allow delete: if false;
    }

    match /cash_registers/{registerId} {
      // Movimento financeiro é da equipe da loja (dono ou operador ativo — o
      // operador é justamente quem abre/fecha caixa). O cardápio do cliente
      // usa store_profiles.isCaixaAberto para saber se o caixa está aberto.
      // O hook de caixa ainda precisa de sessões anteriores para calcular o
      // próximo número e saldos acumulados. A aba/histórico fica escondida na
      // UI, mas a leitura bruta não é separável sem uma projeção server-side.
      allow get, list: if isOwnerOf(resource.data.ownerId)
        || operatorCanOperateCash(resource.data.ownerId)
        || operatorVeHistorico(resource.data.ownerId);
      allow create: if isOwnerOf(request.resource.data.ownerId) || (
        request.resource.data.status == 'aberto'
        && request.resource.data.keys().hasOnly(['ownerId', 'status', 'sessao',
          'saldoInicial', 'dataAbertura', 'usuarioAbertura'])
        && operatorCanPdvAction(request.resource.data.ownerId, 'caixa', 'abrirCaixa')
      );
      allow update: if ownerIdIsUnchanged() && (
        isOwnerOf(resource.data.ownerId) || (
          resource.data.status == 'aberto'
          && request.resource.data.status == 'fechado'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'dataFechamento', 'totalFechamento', 'fechamentoDetalhes'])
          && operatorCanPdvAction(resource.data.ownerId, 'caixa', 'fecharCaixa')
        )
      );
      allow delete: if isOwnerOf(resource.data.ownerId);
    }

    match /cash_transactions/{transactionId} {
      allow get, list: if isOwnerOf(resource.data.ownerId)
        || operatorCanOperateCash(resource.data.ownerId)
        || operatorVeHistorico(resource.data.ownerId);
      allow create: if isOwnerOf(request.resource.data.ownerId)
        || operatorCanCreateCashTransaction(
          request.resource.data.ownerId, request.resource.data);
      allow update: if ownerIdIsUnchanged() && (
        isOwnerOf(resource.data.ownerId) || (
          resource.data.tipo == 'venda'
          && !valueUsesContaCasa(resource.data.get('formaPagamento', ''))
          && request.resource.data.caixaId == resource.data.caixaId
          && cashRegisterIsOpen(resource.data.caixaId, resource.data.ownerId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'canceled', 'canceledAt', 'canceledBy', 'canceledByUid', 'canceledReason'])
          && operatorCanPdvAction(resource.data.ownerId, 'caixa', 'cancelarVenda')
        )
      );
      allow delete: if isOwnerOf(resource.data.ownerId);
    }

    match /clientes/{clienteId} {
      // Leitura exige login (o anônimo do cardápio serve): o my-orders busca
      // o cliente por telefone para a Conta da Casa. Fechar mais que isso
      // exige mover essas consultas para API routes com Admin SDK.
      // `resource == null` é o documento que AINDA NÃO EXISTE. Sem este ramo,
      // perguntar "este cliente já está cadastrado?" pelo id determinístico
      // devolve permission-denied em vez de "não existe" — e foi isso que
      // derrubou a venda com cliente novo (01/08/2026): a leitura negada
      // abortava a venda inteira. Ler um documento inexistente não revela
      // dado nenhum; só o dono logado pode perguntar.
      allow get: if isAnonymous()
        || (resource == null && (isAdmin()
          || (isActiveOperator() && moduloVer(retaguardaDe(operatorData()), 'clientes'))))
        || isOwnerOf(resource.data.ownerId)
        || operatorVeModulo(resource.data.ownerId, 'clientes')
        || operatorVeModulo(resource.data.ownerId, 'prazo');
      allow list: if isAnonymous()
        || isOwnerOf(resource.data.ownerId)
        || operatorVeModulo(resource.data.ownerId, 'clientes')
        || operatorVeModulo(resource.data.ownerId, 'prazo');
      // Base, condições de crédito e sincronização são owner-only. O cliente
      // anônimo mantém apenas a leitura legada necessária ao my-orders.
      allow create: if isOwnerOf(request.resource.data.ownerId)
        || operatorEditaModulo(request.resource.data.ownerId, 'clientes');
      allow update: if (isOwnerOf(resource.data.ownerId)
          || operatorEditaModulo(resource.data.ownerId, 'clientes'))
        && ownerIdIsUnchanged()
        && (
          resource.data.get('mergeInProgress', null) == null
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'archived', 'archivedAt', 'archiveReason', 'mergedInto',
            'creditEnabled', 'mergeInProgress'
          ])
        );
      allow delete: if isOwnerOf(resource.data.ownerId)
        || operatorEditaModulo(resource.data.ownerId, 'clientes');

      match /credit_transactions/{transactionId} {
        // Cliente anônimo lê o extrato legado no my-orders; somente o dono faz
        // lançamentos ou altera a Conta da Casa.
        allow get, list: if isAnonymous()
          || isOwnerOf(get(/databases/$(database)/documents/clientes/$(clienteId)).data.ownerId)
          || operatorVeModulo(
            get(/databases/$(database)/documents/clientes/$(clienteId)).data.ownerId, 'prazo');
        allow create, update, delete: if
          (isOwnerOf(get(/databases/$(database)/documents/clientes/$(clienteId)).data.ownerId)
            || operatorEditaModulo(
              get(/databases/$(database)/documents/clientes/$(clienteId)).data.ownerId, 'prazo'))
          && get(/databases/$(database)/documents/clientes/$(clienteId)).data.get('archived', false) != true
          && get(/databases/$(database)/documents/clientes/$(clienteId)).data.get('mergeInProgress', null) == null;
      }
    }

    match /store_profiles/{profileId} {
      allow get, list: if true;
      // Operador ativo só toca em dois pontos operacionais do perfil:
      // isCaixaAberto (abrir/fechar caixa) e general.disableDelivery (botão
      // liga/desliga delivery do PDV). Todo o resto é só do dono.
      allow update: if (isAdmin() && request.auth.uid == profileId) ||
        // Configurações da loja: um documento só, salvo de uma vez. Por isso a
        // permissão também é uma só (Perfil da loja), e não por sub-aba.
        operatorEditaModulo(profileId, 'perfil') ||
        (isOperatorOf(profileId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isCaixaAberto'])
          && ((request.resource.data.isCaixaAberto == true
              && operatorCanPdvAction(profileId, 'caixa', 'abrirCaixa'))
            || (request.resource.data.isCaixaAberto == false
              && operatorCanPdvAction(profileId, 'caixa', 'fecharCaixa')))) ||
        (isOperatorOf(profileId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['general'])
          && request.resource.data.general.diff(resource.data.general).affectedKeys().hasOnly(['disableDelivery'])
          && operatorCanPdvGlobal(profileId, 'toggleDelivery'));
      allow create, delete: if isAdmin() && request.auth.uid == profileId;
    }

    // Reserva do link curto da loja (/{codigo}). A coleção não tem regra
    // nenhuma até aqui, então toda gravação era negada em silêncio — o
    // AppearanceTab engolia o erro num console.warn e a coleção ficou vazia.
    // O papel dela é ser a TRAVA de unicidade do código: quem chega depois não
    // pode roubar o código de outra loja. `create` só passa em documento que
    // ainda não existe e `update` exige já ser o dono do código, então a
    // reserva alheia é intocável.
    match /store_slugs/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if (isAdmin() && request.resource.data.storeId == request.auth.uid)
        || operatorEditaModulo(request.resource.data.storeId, 'perfil');
      allow update: if resource.data.storeId == request.resource.data.storeId && (
        (isAdmin() && resource.data.storeId == request.auth.uid)
        || operatorEditaModulo(resource.data.storeId, 'perfil'));
      allow delete: if isAdmin() && resource.data.storeId == request.auth.uid;
    }

    // Visita ao cardápio: um registro por sessão de navegador, é o que alimenta
    // o placar da sessão de caixa. Append-only de propósito — ninguém edita nem
    // apaga, e `at` é obrigatoriamente a hora do servidor, então não dá para
    // plantar visita com data escolhida.
    match /store_visits/{visitId} {
      allow create: if request.resource.data.keys().hasOnly(['storeId', 'at', 'visitorId', 'via'])
        && request.resource.data.storeId is string
        && request.resource.data.at == request.time
        && (!('visitorId' in request.resource.data) || request.resource.data.visitorId is string)
        // `via` = de onde a pessoa veio (marca do link que a loja espalhou).
        // É dado de navegação, nunca identidade: cabe no mesmo documento aberto.
        && (!('via' in request.resource.data)
            || (request.resource.data.via is string && request.resource.data.via.size() <= 40));
      allow update, delete: if false;
      allow get, list: if isOwnerOf(resource.data.storeId)
        || operatorVeModulo(resource.data.storeId, 'visitantes');
    }

    // Perfil do visitante do cardápio: o que olhou, o que ficou no carrinho e se
    // o pedido saiu. Diferente da visita (append-only), este documento é
    // REESCRITO conforme a pessoa navega — é o estado atual, um por pessoa.
    //
    // Quem escreve é o cardápio público, e ali o cliente não tem login. A trava
    // possível é o formato + o id do documento: `{loja}__{visitante}` amarra o
    // conteúdo ao caminho, então ninguém escreve no perfil de outro sem
    // adivinhar o id aleatório dele. Leitura, essa sim, é só da própria loja.
    match /store_visitors/{visitanteId} {
      function visitanteBemFormado() {
        return request.resource.data.keys().hasOnly([
            'storeId', 'visitorId', 'primeiraVez', 'ultimaVez', 'sessoes',
            'nome', 'telefone', 'clienteId', 'linhaDoTempo', 'carrinho',
            'pedidos', 'ultimoPedidoId', 'ultimoPedidoValor', 'ultimoPedidoMs',
            'viaLink', 'codigo', 'origemPrimeira', 'origemUltima'
          ])
          && request.resource.data.storeId is string
          && request.resource.data.visitorId is string
          && visitanteId == request.resource.data.storeId + '__' + request.resource.data.visitorId
          && request.resource.data.ultimaVez == request.time
          && (!('linhaDoTempo' in request.resource.data)
              || (request.resource.data.linhaDoTempo is list
                  && request.resource.data.linhaDoTempo.size() <= 40))
          && (!('nome' in request.resource.data)
              || (request.resource.data.nome is string && request.resource.data.nome.size() <= 80))
          && (!('telefone' in request.resource.data)
              || (request.resource.data.telefone is string && request.resource.data.telefone.size() <= 20))
          && (!('clienteId' in request.resource.data) || request.resource.data.clienteId is string)
          && (!('viaLink' in request.resource.data) || request.resource.data.viaLink is bool)
          && (!('codigo' in request.resource.data)
              || (request.resource.data.codigo is string && request.resource.data.codigo.size() <= 12))
          && (!('origemPrimeira' in request.resource.data)
              || (request.resource.data.origemPrimeira is string
                  && request.resource.data.origemPrimeira.size() <= 40))
          && (!('origemUltima' in request.resource.data)
              || (request.resource.data.origemUltima is string
                  && request.resource.data.origemUltima.size() <= 40))
          && (!('carrinho' in request.resource.data) || request.resource.data.carrinho is map);
      }

      allow create: if visitanteBemFormado()
        && (!('primeiraVez' in request.resource.data)
            || request.resource.data.primeiraVez == request.time);
      // `primeiraVez` é a data de "cliente desde": entra uma vez e não se reescreve.
      allow update: if visitanteBemFormado()
        && (('primeiraVez' in resource.data)
            ? request.resource.data.primeiraVez == resource.data.primeiraVez
            : (!('primeiraVez' in request.resource.data)
               || request.resource.data.primeiraVez == request.time))
        // Quem TROUXE a pessoa também não se reescreve. A segunda visita chega
        // pelo link do WhatsApp e apagaria o Instagram que a trouxe — aí toda
        // divulgação pareceria não dar resultado nenhum.
        && (!('origemPrimeira' in resource.data)
            || !('origemPrimeira' in request.resource.data)
            || request.resource.data.origemPrimeira == resource.data.origemPrimeira);
      allow delete: if false;
      allow get, list: if isOwnerOf(resource.data.storeId)
        || operatorVeModulo(resource.data.storeId, 'visitantes');
    }

    match /active_sessions/{sessionId} {
      // Ping de presença do cardápio: o cliente pode ainda não estar logado,
      // então a escrita é aberta mas restrita ao formato do ping.
      allow create, update: if request.resource.data.keys().hasOnly(['storeId', 'lastActive']);
      allow delete: if true;
      // Leitura agora é isolada por loja. A query do painel deve filtrar por
      // storeId; rules não usam o filtro local como barreira de segurança.
      allow get, list: if isOwnerOf(resource.data.storeId)
        || operatorVeModulo(resource.data.storeId, 'visitantes');
    }

    match /promotions/{promoId} {
      allow get, list: if true;
      allow create: if (isAdmin() && request.resource.data.ownerId == request.auth.uid)
        || operatorEditaModulo(request.resource.data.ownerId, 'ofertas');
      allow update: if ownerIdIsUnchanged() && (
        (isAdmin() && resource.data.ownerId == request.auth.uid)
        || operatorEditaModulo(resource.data.ownerId, 'ofertas'));
      allow delete: if (isAdmin() && resource.data.ownerId == request.auth.uid)
        || operatorEditaModulo(resource.data.ownerId, 'ofertas');
    }

    match /campaigns/{campaignId} {
      allow get, list: if (isAdmin() && resource.data.ownerId == request.auth.uid)
        || operatorVeModulo(resource.data.ownerId, 'campanhas');
      allow create: if (isAdmin() && request.resource.data.ownerId == request.auth.uid)
        || operatorEditaModulo(request.resource.data.ownerId, 'campanhas');
      allow update: if ownerIdIsUnchanged() && (
        (isAdmin() && resource.data.ownerId == request.auth.uid)
        || operatorEditaModulo(resource.data.ownerId, 'campanhas'));
      allow delete: if (isAdmin() && resource.data.ownerId == request.auth.uid)
        || operatorEditaModulo(resource.data.ownerId, 'campanhas');
    }

    match /broadcast_lists/{listId} {
      allow get, list: if (isAdmin() && resource.data.ownerId == request.auth.uid)
        || operatorVeModulo(resource.data.ownerId, 'campanhas');
      allow create: if (isAdmin() && request.resource.data.ownerId == request.auth.uid)
        || operatorEditaModulo(request.resource.data.ownerId, 'campanhas');
      allow update: if ownerIdIsUnchanged() && (
        (isAdmin() && resource.data.ownerId == request.auth.uid)
        || operatorEditaModulo(resource.data.ownerId, 'campanhas'));
      allow delete: if (isAdmin() && resource.data.ownerId == request.auth.uid)
        || operatorEditaModulo(resource.data.ownerId, 'campanhas');
    }

    // Disparo agendado/segundo plano. O dono cria e lê (progresso em realtime) e
    // pode cancelar (update/delete). Os writes de envio (cursor/sent/failed/...)
    // são feitos pelo servidor via Admin SDK, que ignora estas regras.
    match /scheduled_campaigns/{campaignId} {
      allow get, list: if (isAdmin() && resource.data.ownerId == request.auth.uid)
        || operatorVeModulo(resource.data.ownerId, 'campanhas');
      allow create: if (isAdmin() && request.resource.data.ownerId == request.auth.uid)
        || operatorEditaModulo(request.resource.data.ownerId, 'campanhas');
      allow update: if ownerIdIsUnchanged() && (
        (isAdmin() && resource.data.ownerId == request.auth.uid)
        || operatorEditaModulo(resource.data.ownerId, 'campanhas'));
      allow delete: if (isAdmin() && resource.data.ownerId == request.auth.uid)
        || operatorEditaModulo(resource.data.ownerId, 'campanhas');
    }

    match /whatsapp_messages/{messageId} {
      allow get, list: if (isAdmin() && resource.data.ownerId == request.auth.uid)
        || operatorVeModulo(resource.data.ownerId, 'whatsapp')
        || operatorVeModulo(resource.data.ownerId, 'campanhas');
      allow create: if (isAdmin()
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.empresaId == request.auth.uid)
        || (request.resource.data.ownerId == request.resource.data.empresaId
          && (operatorEditaModulo(request.resource.data.ownerId, 'whatsapp')
            || operatorEditaModulo(request.resource.data.ownerId, 'campanhas')));
      allow update, delete: if false;
    }
  }
}
