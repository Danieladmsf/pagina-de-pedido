
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isAnonymous() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isOwnerOf(ownerId) {
      return isAdmin() && request.auth.uid == ownerId;
    }

    // ── Operadores (frente de caixa) ──
    // roles_operador/{uid} mapeia um login de operador para a loja (ownerId).
    // Operador ATIVO tem acesso de "staff" apenas ao operacional (pedidos,
    // caixa e estoque); clientes, cadastros e perfil continuam só do dono.
    function isOperator() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_operador/$(request.auth.uid));
    }

    function operatorData() {
      return get(/databases/$(database)/documents/roles_operador/$(request.auth.uid)).data;
    }

    function isActiveOperator() {
      return isOperator() && operatorData().active == true;
    }

    function isOperatorOf(ownerId) {
      return isActiveOperator() && operatorData().ownerId == ownerId;
    }

    // Permissões de operador são sempre fail-closed nas rules. Diferente do
    // perfil legado do dono, campo ausente/inválido NUNCA concede acesso.
    function operatorPdvPermissions() {
      return operatorData().get('permissions', {}).get('pdv', {});
    }

    function operatorCanPdvTab(ownerId, tab) {
      return isOperatorOf(ownerId)
        && operatorPdvPermissions().get('enabled', false) == true
        && operatorPdvPermissions().get('tabs', {}).get(tab, false) == true;
    }

    function operatorCanPdvAction(ownerId, group, action) {
      return isOperatorOf(ownerId)
        && operatorPdvPermissions().get('enabled', false) == true
        && operatorPdvPermissions().get('tabs', {}).get(group, false) == true
        && operatorPdvPermissions().get('actions', {}).get(group, {}).get(action, false) == true;
    }

    function operatorCanPdvGlobal(ownerId, control) {
      return isOperatorOf(ownerId)
        && operatorPdvPermissions().get('enabled', false) == true
        && operatorPdvPermissions().get('global', {}).get(control, false) == true;
    }

    function valueUsesContaCasa(value) {
      return value is string && value.matches('.*conta_casa.*');
    }

    function usesContaCasa(data) {
      return valueUsesContaCasa(data.get('paymentMethod', ''));
    }

    function operatorCanReadOrders(ownerId) {
      return operatorCanPdvTab(ownerId, 'delivery')
        || operatorCanPdvTab(ownerId, 'novo_pedido')
        || operatorCanPdvTab(ownerId, 'mesas');
    }

    function operatorCanCreateOrder(ownerId, data) {
      return !usesContaCasa(data) && (
        (data.get('orderType', '') == 'dine_in'
          && operatorCanPdvAction(ownerId, 'mesas', 'gerenciarMesa')
          && operatorCanPdvAction(ownerId, 'mesas', 'lancarItens'))
        || (data.get('source', '') == 'pdv'
          && data.get('orderType', '') != 'dine_in'
          && operatorCanPdvAction(ownerId, 'novo_pedido', 'finalizarVenda')
          && ((data.get('discount', 0) == 0 && data.get('surcharge', 0) == 0)
            || operatorCanPdvAction(ownerId, 'novo_pedido', 'descontoAcrescimo'))
          && !usesContaCasa(data))
      );
    }

    function operatorCanAdjustInventory(ownerId) {
      return operatorCanPdvAction(ownerId, 'delivery', 'finalizarPedido')
        || operatorCanPdvAction(ownerId, 'delivery', 'editarItens')
        || operatorCanPdvAction(ownerId, 'delivery', 'cancelarPedido')
        || operatorCanPdvAction(ownerId, 'novo_pedido', 'finalizarVenda')
        || operatorCanPdvAction(ownerId, 'mesas', 'lancarItens')
        || operatorCanPdvAction(ownerId, 'mesas', 'fecharComanda')
        || operatorCanPdvAction(ownerId, 'mesas', 'gerenciarMesa')
        || operatorCanPdvAction(ownerId, 'mesas', 'aceitarPedidoOnline');
    }

    function operatorCanOperateCash(ownerId) {
      // useCaixa é compartilhado pelas vendas: mesmo sem exibir a aba Caixa,
      // essas ações precisam descobrir o caixa aberto e lançar o pagamento.
      return operatorCanPdvTab(ownerId, 'caixa')
        || operatorCanPdvAction(ownerId, 'delivery', 'finalizarPedido')
        || operatorCanPdvAction(ownerId, 'novo_pedido', 'finalizarVenda')
        || operatorCanPdvAction(ownerId, 'mesas', 'fecharComanda')
        || operatorCanPdvAction(ownerId, 'encomendas_pedidos', 'lancarSinal');
    }

    function operatorCanUpdateDeliveryOrder(ownerId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let nextStatus = request.resource.data.get('status', resource.data.get('status', ''));
      return resource.data.get('orderType', '') in ['delivery', 'pickup'] && (
        (nextStatus == 'canceled'
          && changed.hasOnly(['status', 'stockDeducted', 'stockDeductedItems'])
          && operatorCanPdvAction(ownerId, 'delivery', 'cancelarPedido'))
        || (nextStatus == 'delivered'
          && changed.hasOnly(['status', 'paymentMethod', 'discount', 'surcharge',
            'payDeliveryToMotoboy', 'totalAmount', 'stockDeducted', 'stockDeductedItems'])
          && operatorCanPdvAction(ownerId, 'delivery', 'finalizarPedido')
          && ((request.resource.data.get('discount', 0)
                == resource.data.get('discount', 0)
              && request.resource.data.get('surcharge', 0)
                == resource.data.get('surcharge', 0))
            || operatorCanPdvAction(ownerId, 'delivery', 'descontoAcrescimo')))
        || (changed.hasOnly(['items', 'subtotal', 'totalAmount',
              'stockDeducted', 'stockDeductedItems'])
          && changed.hasAny(['items', 'subtotal', 'totalAmount'])
          && operatorCanPdvAction(ownerId, 'delivery', 'editarItens'))
        || (nextStatus != 'delivered' && nextStatus != 'canceled'
          && changed.hasOnly(['status', 'motoboyId', 'orderType'])
          && operatorCanPdvAction(ownerId, 'delivery', 'mudarStatus'))
        || (changed.hasOnly(['stockDeducted', 'stockDeductedItems'])
          && operatorCanAdjustInventory(ownerId))
        || (changed.hasOnly(['customerCounted'])
          && request.resource.data.customerCounted == true
          && (operatorCanPdvAction(ownerId, 'delivery', 'finalizarPedido')
            || (resource.data.get('source', '') == 'pdv'
              && operatorCanPdvAction(ownerId, 'novo_pedido', 'finalizarVenda'))))
        || (changed.hasOnly(['receivedMessageSent', 'pixProofMessageSent',
              'outForDeliveryMessageSent', 'canceledMessageSent'])
          && operatorCanPdvTab(ownerId, 'delivery'))
      );
    }

    function operatorCanUpdateTableOrder(ownerId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let nextStatus = request.resource.data.get('status', resource.data.get('status', ''));
      return resource.data.get('orderType', '') == 'dine_in' && (
        (nextStatus == 'canceled'
          && changed.hasOnly(['status', 'items', 'subtotal', 'totalAmount',
            'stockDeducted', 'stockDeductedItems'])
          && (operatorCanPdvAction(ownerId, 'mesas', 'gerenciarMesa')
            || (resource.data.get('source', '') != 'pdv'
              && resource.data.get('accepted', false) != true
              && operatorCanPdvAction(ownerId, 'mesas', 'aceitarPedidoOnline'))))
        || (nextStatus == 'delivered'
          && changed.hasOnly(['status', 'paymentMethod', 'discount', 'surcharge',
            'subtotal', 'totalAmount', 'customerName', 'customerPhone',
            'stockDeducted', 'stockDeductedItems'])
          && operatorCanPdvAction(ownerId, 'mesas', 'fecharComanda')
          && ((request.resource.data.get('discount', 0)
                == resource.data.get('discount', 0)
              && request.resource.data.get('surcharge', 0)
                == resource.data.get('surcharge', 0))
            || operatorCanPdvAction(ownerId, 'mesas', 'descontoAcrescimo'))
          && (!usesContaCasa(request.resource.data)
            || operatorCanPdvAction(ownerId, 'mesas', 'vendaPrazo')))
        || (changed.hasOnly(['items', 'subtotal', 'totalAmount',
              'customerName', 'customerPhone', 'stockDeducted', 'stockDeductedItems'])
          && changed.hasAny(['items', 'subtotal', 'totalAmount'])
          && operatorCanPdvAction(ownerId, 'mesas', 'lancarItens')
          && (!changed.hasAny(['customerName', 'customerPhone'])
            || operatorCanPdvAction(ownerId, 'mesas', 'gerenciarMesa')))
        || (changed.hasOnly(['customerName', 'customerPhone'])
          && operatorCanPdvAction(ownerId, 'mesas', 'gerenciarMesa'))
        || (changed.hasOnly(['tableNumber', 'accepted'])
          && changed.hasAny(['tableNumber'])
          && operatorCanPdvAction(ownerId, 'mesas', 'gerenciarMesa')
          && ((resource.data.get('source', '') == 'pdv'
                || resource.data.get('accepted', false) == true)
            || operatorCanPdvAction(ownerId, 'mesas', 'aceitarPedidoOnline')))
        || (changed.hasOnly(['accepted'])
          && request.resource.data.accepted == true
          && operatorCanPdvAction(ownerId, 'mesas', 'aceitarPedidoOnline'))
        || (changed.hasOnly(['status'])
          && nextStatus == 'awaiting_payment'
          && operatorCanPdvAction(ownerId, 'mesas', 'fecharComanda'))
        || (changed.hasOnly(['status'])
          && nextStatus == 'pending'
          && operatorCanPdvAction(ownerId, 'mesas', 'gerenciarMesa'))
        || (changed.hasOnly(['stockDeducted', 'stockDeductedItems'])
          && operatorCanAdjustInventory(ownerId))
        || (changed.hasOnly(['customerCounted'])
          && request.resource.data.customerCounted == true
          && operatorCanPdvAction(ownerId, 'mesas', 'fecharComanda'))
        || (changed.hasOnly(['receivedMessageSent', 'pixProofMessageSent',
              'outForDeliveryMessageSent', 'canceledMessageSent'])
          && operatorCanPdvTab(ownerId, 'mesas'))
      );
    }

    function operatorCanUpdateOrder(ownerId) {
      return isOperatorOf(ownerId)
        && !usesContaCasa(resource.data)
        && !usesContaCasa(request.resource.data)
        && (operatorCanUpdateDeliveryOrder(ownerId)
          || operatorCanUpdateTableOrder(ownerId));
    }

    function cashRegisterOwner(registerId) {
      return get(/databases/$(database)/documents/cash_registers/$(registerId)).data.ownerId;
    }

    function cashRegisterIsOpen(registerId, ownerId) {
      let register = get(
        /databases/$(database)/documents/cash_registers/$(registerId)).data;
      return register.ownerId == ownerId && register.status == 'aberto';
    }

    function cashRegisterWillBeClosed(registerId, ownerId) {
      let registerAfter = getAfter(
        /databases/$(database)/documents/cash_registers/$(registerId)).data;
      return registerAfter.ownerId == ownerId
        && registerAfter.status == 'fechado';
    }

    function operatorCanCreateCashTransaction(ownerId, data) {
      let type = data.get('tipo', '');
      return cashRegisterOwner(data.caixaId) == ownerId && (
        // No batch de fechamento, suprimentos/sangrias automáticos pertencem
        // à capacidade fecharCaixa (não aos botões manuais homônimos).
        (type in ['sangria', 'suprimento', 'fechamento', 'retirada_fechamento']
          && cashRegisterIsOpen(data.caixaId, ownerId)
          && cashRegisterWillBeClosed(data.caixaId, ownerId)
          && operatorCanPdvAction(ownerId, 'caixa', 'fecharCaixa'))
        || (cashRegisterIsOpen(data.caixaId, ownerId) && (
          (type == 'abertura'
            && operatorCanPdvAction(ownerId, 'caixa', 'abrirCaixa'))
          || (type == 'sangria'
            && operatorCanPdvAction(ownerId, 'caixa', 'sangria'))
          || (type == 'suprimento'
            && operatorCanPdvAction(ownerId, 'caixa', 'suprimento'))
          || (type == 'venda' && (
            !valueUsesContaCasa(data.get('formaPagamento', ''))
            && (operatorCanPdvAction(ownerId, 'delivery', 'finalizarPedido')
              || operatorCanPdvAction(ownerId, 'novo_pedido', 'finalizarVenda')
              || operatorCanPdvAction(ownerId, 'mesas', 'fecharComanda')
              || operatorCanPdvAction(ownerId, 'encomendas_pedidos', 'lancarSinal'))
          ))
        ))
      );
    }

    // Regras para a coleção roles_admin
    match /roles_admin/{userId} {
      // Cadastro de loja cria o próprio registro de admin. Login anônimo
      // (clientes do cardápio) não pode se autopromover a admin.
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        // Um operador já provisionado jamais pode virar master criando o
        // próprio roles_admin. Novas lojas legítimas ainda usam este fluxo.
        && !exists(/databases/$(database)/documents/roles_operador/$(request.auth.uid));
      allow get, list, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false; // Por segurança, não permite deletar admin via app
    }

    match /roles_operador/{operatorUid} {
      // O próprio operador lê seu papel (é assim que o app resolve qual loja
      // ele opera); o dono lê/lista/edita os operadores da SUA loja.
      allow get: if isSignedIn() && (
        request.auth.uid == operatorUid ||
        (isAdmin() && resource.data.ownerId == request.auth.uid)
      );
      allow list: if isAdmin() && resource.data.ownerId == request.auth.uid;
      // Todo write passa pela API/Admin SDK: além de criar/remover o usuário do
      // Auth, ela valida ownerId e impede promoção/edição das próprias flags.
      allow create, update, delete: if false;
    }

    // Segredo da senha da Retaguarda. Nunca fica no perfil público da loja:
    // somente a sessão autenticada do próprio dono pode ler ou alterar.
    match /admin_secrets/{userId} {
      allow read, write: if isAdmin() && request.auth.uid == userId;
    }

    // Regras para Categorias e Itens
    // Adicionamos a lógica de ownerId para isolar os dados
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && (
        (request.method == 'create' && request.resource.data.ownerId == request.auth.uid) ||
        (resource.data.ownerId == request.auth.uid)
      );
    }

    match /menuItems/{menuItemId} {
      allow get, list: if true;
      allow create, delete: if isAdmin() && (
        (request.method == 'create' && request.resource.data.ownerId == request.auth.uid) ||
        (resource.data.ownerId == request.auth.uid)
      );
      // Cliente (anônimo) só pode BAIXAR o estoque ao fazer pedido — nunca
      // aumentar nem deixar negativo. Reposição/estorno é só do dono (admin).
      // Operador ativo pode mexer APENAS no estoque (baixa na venda e estorno
      // no cancelamento via lib/inventory) — nunca em preço/nome/etc.
      allow update: if isOwnerOf(resource.data.ownerId) ||
        (operatorCanAdjustInventory(resource.data.ownerId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockQuantity'])) ||
        (isAnonymous()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockQuantity'])
          && request.resource.data.stockQuantity is number
          && request.resource.data.stockQuantity >= 0
          && resource.data.stockQuantity is number
          && request.resource.data.stockQuantity < resource.data.stockQuantity);
    }

    match /addons/{addonId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && (
        (request.method == 'create' && request.resource.data.ownerId == request.auth.uid) ||
        (resource.data.ownerId == request.auth.uid)
      );
    }

    match /addonCategories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && (
        (request.method == 'create' && request.resource.data.ownerId == request.auth.uid) ||
        (resource.data.ownerId == request.auth.uid)
      );
    }

    match /customers/{userId} {
      allow get, update, create: if isSignedIn() && request.auth.uid == userId;
      allow list, delete: if false;
    }

    match /orders/{orderId} {
      // Cliente lê os próprios pedidos via customerUid (uid anônimo gravado
      // na criação); a equipe da loja (dono ou operador) lê os pedidos dela.
      // A query do cliente PRECISA filtrar por customerUid == uid.
      allow get, list: if isSignedIn() && (
        resource.data.customerUid == request.auth.uid ||
        isOwnerOf(resource.data.ownerId) ||
        operatorCanReadOrders(resource.data.ownerId)
      );
      allow update: if isOwnerOf(resource.data.ownerId)
        || operatorCanUpdateOrder(resource.data.ownerId);
      allow create: if isSignedIn() && (
        request.resource.data.customerUid == request.auth.uid ||
        isOwnerOf(request.resource.data.ownerId) ||
        operatorCanCreateOrder(request.resource.data.ownerId, request.resource.data)
      );
      allow delete: if false;
    }

    // Encomendas (modalidade confeitaria): mesmo modelo de orders, em coleção
    // PRÓPRIA (não filtrada pela janela do caixa — registra com caixa fechado).
    // Cliente (anônimo) cria a própria encomenda (customerUid == uid); a
    // equipe da loja lê/atualiza as encomendas dela.
    match /encomendas/{encomendaId} {
      allow get, list: if isSignedIn() && (
        resource.data.customerUid == request.auth.uid ||
        isOwnerOf(resource.data.ownerId) ||
        operatorCanPdvTab(resource.data.ownerId, 'encomendas_pedidos')
      );
      allow create: if isSignedIn() && (
        request.resource.data.customerUid == request.auth.uid ||
        isOwnerOf(request.resource.data.ownerId)
      );
      allow update: if isOwnerOf(resource.data.ownerId) || (
        isOperatorOf(resource.data.ownerId)
        && !usesContaCasa(resource.data)
        && !usesContaCasa(request.resource.data) && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && operatorCanPdvAction(resource.data.ownerId,
              'encomendas_pedidos', 'mudarStatus'))
          // Lançar a entrada no caixa: marca o sinal e soma em valorPago (o
          // campo que diz quanto ainda falta receber na entrega).
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sinalLancado', 'valorPago'])
            && request.resource.data.sinalLancado == true
            && operatorCanPdvAction(resource.data.ownerId,
              'encomendas_pedidos', 'lancarSinal'))
          // Fechamento da entrega: recebe o que falta e marca como entregue.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'valorPago'])
            && request.resource.data.status == 'entregue'
            && operatorCanPdvAction(resource.data.ownerId,
              'encomendas_pedidos', 'mudarStatus')
            && operatorCanPdvAction(resource.data.ownerId,
              'encomendas_pedidos', 'lancarSinal'))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'delivery', 'orderNotes', 'customerName', 'customerPhone', 'status'])
            && request.resource.data.diff(resource.data).affectedKeys().hasAny([
                'delivery', 'orderNotes', 'customerName', 'customerPhone'])
            && operatorCanPdvAction(resource.data.ownerId,
              'encomendas_pedidos', 'editarEncomenda')
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
              || operatorCanPdvAction(resource.data.ownerId,
                'encomendas_pedidos', 'mudarStatus')))
        )
      );
      allow delete: if false;
    }

    match /cash_registers/{registerId} {
      // Movimento financeiro é da equipe da loja (dono ou operador ativo — o
      // operador é justamente quem abre/fecha caixa). O cardápio do cliente
      // usa store_profiles.isCaixaAberto para saber se o caixa está aberto.
      // O hook de caixa ainda precisa de sessões anteriores para calcular o
      // próximo número e saldos acumulados. A aba/histórico fica escondida na
      // UI, mas a leitura bruta não é separável sem uma projeção server-side.
      allow get, list: if isOwnerOf(resource.data.ownerId)
        || operatorCanOperateCash(resource.data.ownerId);
      allow create: if isOwnerOf(request.resource.data.ownerId) || (
        request.resource.data.status == 'aberto'
        && request.resource.data.keys().hasOnly(['ownerId', 'status', 'sessao',
          'saldoInicial', 'dataAbertura', 'usuarioAbertura'])
        && operatorCanPdvAction(request.resource.data.ownerId, 'caixa', 'abrirCaixa')
      );
      allow update: if isOwnerOf(resource.data.ownerId) || (
        request.resource.data.ownerId == resource.data.ownerId
        && resource.data.status == 'aberto'
        && request.resource.data.status == 'fechado'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'dataFechamento', 'totalFechamento', 'fechamentoDetalhes'])
        && operatorCanPdvAction(resource.data.ownerId, 'caixa', 'fecharCaixa')
      );
      allow delete: if isOwnerOf(resource.data.ownerId);
    }

    match /cash_transactions/{transactionId} {
      allow get, list: if isOwnerOf(resource.data.ownerId)
        || operatorCanOperateCash(resource.data.ownerId);
      allow create: if isOwnerOf(request.resource.data.ownerId)
        || operatorCanCreateCashTransaction(
          request.resource.data.ownerId, request.resource.data);
      allow update: if isOwnerOf(resource.data.ownerId) || (
        resource.data.tipo == 'venda'
        && !valueUsesContaCasa(resource.data.get('formaPagamento', ''))
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.caixaId == resource.data.caixaId
        && cashRegisterIsOpen(resource.data.caixaId, resource.data.ownerId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'canceled', 'canceledAt', 'canceledBy', 'canceledByUid', 'canceledReason'])
        && operatorCanPdvAction(resource.data.ownerId, 'caixa', 'cancelarVenda')
      );
      allow delete: if isOwnerOf(resource.data.ownerId);
    }

    match /clientes/{clienteId} {
      // Leitura exige login (o anônimo do cardápio serve): o my-orders busca
      // o cliente por telefone para a Conta da Casa. Fechar mais que isso
      // exige mover essas consultas para API routes com Admin SDK.
      allow get, list: if isAnonymous()
        || isOwnerOf(resource.data.ownerId);
      // Base, condições de crédito e sincronização são owner-only. O cliente
      // anônimo mantém apenas a leitura legada necessária ao my-orders.
      allow create: if isOwnerOf(request.resource.data.ownerId);
      allow update: if isOwnerOf(resource.data.ownerId);
      allow delete: if isOwnerOf(resource.data.ownerId);

      match /credit_transactions/{transactionId} {
        // Cliente anônimo lê o extrato legado no my-orders; somente o dono faz
        // lançamentos ou altera a Conta da Casa.
        allow get, list: if isAnonymous()
          || isOwnerOf(get(/databases/$(database)/documents/clientes/$(clienteId)).data.ownerId);
        allow create, update, delete: if
          isOwnerOf(get(/databases/$(database)/documents/clientes/$(clienteId)).data.ownerId);
      }
    }

    match /store_profiles/{profileId} {
      allow get, list: if true;
      // Operador ativo só toca em dois pontos operacionais do perfil:
      // isCaixaAberto (abrir/fechar caixa) e general.disableDelivery (botão
      // liga/desliga delivery do PDV). Todo o resto é só do dono.
      allow update: if (isAdmin() && request.auth.uid == profileId) ||
        (isOperatorOf(profileId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isCaixaAberto'])
          && ((request.resource.data.isCaixaAberto == true
              && operatorCanPdvAction(profileId, 'caixa', 'abrirCaixa'))
            || (request.resource.data.isCaixaAberto == false
              && operatorCanPdvAction(profileId, 'caixa', 'fecharCaixa')))) ||
        (isOperatorOf(profileId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['general'])
          && request.resource.data.general.diff(resource.data.general).affectedKeys().hasOnly(['disableDelivery'])
          && operatorCanPdvGlobal(profileId, 'toggleDelivery'));
      allow create, delete: if isAdmin() && request.auth.uid == profileId;
    }

    match /active_sessions/{sessionId} {
      // Ping de presença do cardápio: o cliente pode ainda não estar logado,
      // então a escrita é aberta mas restrita ao formato do ping.
      allow create, update: if request.resource.data.keys().hasOnly(['storeId', 'lastActive']);
      allow delete: if true;
      // Leitura agora é isolada por loja. A query do painel deve filtrar por
      // storeId; rules não usam o filtro local como barreira de segurança.
      allow get, list: if isOwnerOf(resource.data.storeId)
        || operatorCanPdvTab(resource.data.storeId, 'delivery');
    }

    match /promotions/{promoId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && (
        (request.method == 'create' && request.resource.data.ownerId == request.auth.uid) ||
        (resource.data.ownerId == request.auth.uid)
      );
    }

    match /campaigns/{campaignId} {
      allow get, list: if isAdmin() && resource.data.ownerId == request.auth.uid;
      allow create: if isAdmin() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin() && resource.data.ownerId == request.auth.uid;
    }

    match /broadcast_lists/{listId} {
      allow get, list: if isAdmin() && resource.data.ownerId == request.auth.uid;
      allow create: if isAdmin() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin() && resource.data.ownerId == request.auth.uid;
    }

    // Disparo agendado/segundo plano. O dono cria e lê (progresso em realtime) e
    // pode cancelar (update/delete). Os writes de envio (cursor/sent/failed/...)
    // são feitos pelo servidor via Admin SDK, que ignora estas regras.
    match /scheduled_campaigns/{campaignId} {
      allow get, list: if isAdmin() && resource.data.ownerId == request.auth.uid;
      allow create: if isAdmin() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin() && resource.data.ownerId == request.auth.uid;
    }

    match /whatsapp_messages/{messageId} {
      allow get, list: if isAdmin() && resource.data.ownerId == request.auth.uid;
      allow create: if isAdmin()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.empresaId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
